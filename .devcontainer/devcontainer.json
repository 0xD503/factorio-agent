// Development container: https://containers.dev
// Host requirements: a container engine (Docker or Podman), a POSIX shell, git.
// Factorio is not included: see compose.yaml and factorio/README.md.
{
    "name": "factorio-agent",
    "dockerComposeFile": "compose.yaml",
    "service": "dev",
    "workspaceFolder": "/workspaces/factorio-agent",
    "remoteUser": "dev",
    "updateRemoteUserUID": true,
    "postCreateCommand": "python3 fx.py doctor || true",
    "customizations": {
        "vscode": {
            "extensions": [
                "EditorConfig.EditorConfig",
                "charliermarsh.ruff",
                "JohnnyMorganz.stylua",
                "ms-python.python",
                "sumneko.lua"
            ]
        }
    }
}
