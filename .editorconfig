# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
# Two trailing spaces are a line break in Markdown.
trim_trailing_whitespace = false

[*.cmd]
# cmd.exe misreads some batch files with LF line endings.
end_of_line = crlf

[LICENSE]
# The canonical Apache 2.0 text, kept byte for byte.
indent_size = unset
trim_trailing_whitespace = false
